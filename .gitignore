# 3. macOS Pollution
.DS_Store
.AppleDouble
.LSOverride
._*

# 4. System & Editor Caches
*.log
*.tmp
*.swp
__pycache__/
.vscode/

# 5 Ignore the dev _archive
_archive/
/os-install
