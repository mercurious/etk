# GT5P Spec III PSN (NPEA00050): boot -> My Page -> Arcade -> High Speed Ring -> Drift Trial -> gtdrive
# -> graceful Pitlink EXIT. This is the route car8's 10-24 GT5P matrix ACTUALLY drove (Triage_car8_20261024
# run #2 frames: Track Select rested on High Speed Ring, `right` moved Time Trial -> Drift Trial, the drive
# HUD reads Section / Score) although its macro, gt5p_daytona_tt.macro, is named for Daytona Time Trial.
# Same course, same drive args, so 0.10.1 runs compare with those 0.10.0 rows.
# Frame-driven (car8 2026-10-25): every menu hop is `settle MAX` (on as soon as the screen answered and
# held still; MAX = the old fixed sleep), the track load is `wait_motion` (the flyover moves). The boot
# wait stays fixed: splash/intro timing is the game's. Disc variant: gt5p_disc_hsr_drift.macro.
sleep 45                      # first lit -> SCE splash; Start there lands on My Page (10-24)
snap r1_title
press start
settle 12                     # -> My Page (cursor rests on Arcade; the wake below covers a hidden bar)
snap r2_my_page
press l3                      # wake: GT5P menus auto-hide when idle and the first press only reveals them
sleep 0.5                     # (car8 2026-10-25: a cross on a hidden My Page / a right on a hidden Race Mode
press cross                   # bar was eaten); L3 does nothing on a visible menu
settle 4                      # -> Track Select (rests on High Speed Ring); menus load < 3 s, so a short MAX
snap r3_track_select          # keeps an animated background from idling the bar into hiding
press l3
sleep 0.5
press cross
settle 4                      # -> Race Mode, Time Trial highlighted
snap r4_race_mode
press l3
sleep 0.5
press right
settle 3                      # -> Drift Trial highlighted
snap r5_drift_trial
press l3
sleep 0.5
press cross
settle 6                      # -> Driving Options (cursor on OK: no wake press there, a d-pad would move it)
snap r6_driving_options
press cross                   # OK -> records / LOADING -> GT logo -> the track loads
wait_motion 90                # the flyover moves (10-24: ~40 s)
snap r7_flyover
press start                   # Start brings up the menu over the flyover ...
sleep 1.0
press cross                   # ... X then X within 1.5 s (the menu auto-hides into the flyover)
sleep 1.0
press cross
sleep 5
snap r8_start
drive --wait-race 120 --mt --map-y1 155 --secs 600 --restart-every 60 --max-restarts 20 --snap-every 30
exit                          # waits for gtdrive, takes the wheel, Pitlink EXIT -> CLEAN row
