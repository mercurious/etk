# ============================================================
# ETK OPERATOR CONFIG  (etk.conf — gitignored)
# ============================================================
# This file is auto-generated by ./install.sh on first run.
# Edit values freely; re-run ./install.sh to push changes to the rig.
# Lines starting with # are comments; blank lines are ignored.
# ============================================================

# --- Rig SSH target ---
# Rocknix publishes itself via mDNS as <SOC>.local out of the box:
#   SM8250.local — Retroid Pocket Flip 2, RP5, other SD865 devices
#   SM8550.local — Odin 2 family
# This default works on any LAN where mDNS is functioning, so you
# don't need to edit it when you change WiFi networks. If your
# network blocks mDNS, replace with an IP form (e.g. root@10.0.0.40).
RIG_SSH="root@SM8250.local"

# --- Build tier ---
# FULL — shader vault + thermal protection + HUD telemetry (recommended)
# LITE — thermal protection + HUD only (for saturated shader caches)
# RAW  — HUD only, no protection (for stress testing)
ETK_BUILD_TYPE="FULL"

# --- Host<->rig shader sync (Tier-A vault) ---
# Controls how install.sh syncs the harvested SHADER vault between this computer
# and the rig. (Your telemetry/tuned configs/saves — Tier-B — are always backed
# up rig->host on every run regardless of this, and only restored host->rig with
# --restore-state.) Override per-run with `./install.sh --sync-mode=MODE`.
#   full   — pull (rig->host harvest) AND push (host->rig restore). The classic
#            two-way mirror; use if the host PC is your shader backup/restore.
#   backup — pull ONLY. Host is a read-only archive; install never pushes shaders
#            back, so a stale host vault can't re-seed the rig after a Mesa bump.
#            RECOMMENDED once you back shaders up to your Private Paddock (PADDOCK
#            tab), which then owns restore.
#   off    — no host shader sync at all. Leanest; rely entirely on Private Paddock.
VAULT_SYNC="full"

# --- Custom Turnip driver catalog (Stage IV — optional) ---
# Every Mesa Turnip .so (ROCKNIX glibc/msm build) you drop in this repo's
# drivers/ folder is staged into the on-rig CATALOG (/storage/turnip/drivers/).
# Pick which one binds over the stock /usr/lib driver from Pitstop's DRIVER tab
# (DRIVER BUILD selector) and reboot to load it — the choice persists across
# reboot and reinstall. 'stock' = run ROCKNIX's own Turnip (unbind). Builds come
# from scripts/build_rocknix.sh, or download community Adreno-650 forks into
# drivers/. Re-validate any swap on a COLD boot.
#
# TURNIP_SO (optional): path to ONE .so that is the DEFAULT pick on a rig that
# hasn't chosen yet (also staged into the catalog if it lives outside drivers/).
# Leave EMPTY to default a fresh rig to stock.
TURNIP_SO=""

# --- Custom RPCS3 build (GTK Edition — optional) ---
# rpcs3-sa also lives on read-only squashfs (/usr/bin), same story as Turnip's
# /usr/lib driver. Unlike Turnip there's no Pitstop-tab catalog/selector here —
# just a single on/off flag. Path to an RPCS3 AppImage (ROCKNIX aarch64/glibc
# target) to bind-mount over /usr/bin/rpcs3-sa on every boot. The 0.6.0
# "RPCS3 GTK Edition" build ships as an ETK GitHub release asset — download it
# and point this at the file, e.g.:
#   RPCS3_APPIMAGE="$HOME/Downloads/rpcs3-etk_gtk-edition-0.6.0_v0.0.41-19544-60c9705a_linux_aarch64.AppImage"
# (source delta + build recipe: github.com/mercurious/etk-rpcs3-gtk). Leave
# EMPTY to run ROCKNIX's stock rpcs3-sa. Reboot to fully validate (a
# bind-mount can't hot-swap a binary a running RPCS3 already has open).
RPCS3_APPIMAGE=""

# RPCS3_ENV_FLAGS (optional): space-separated VAR=value pairs exported into
# the RPCS3 runtime at every game launch via the profile.d vector
# (/storage/.config/profile.d/096-etk-rpcs3-flags). Used for runtime-gated
# switches baked into a custom RPCS3 build. The GTK Edition needs NOTHING
# here for normal play — the #11912 road-flicker FIX is ON BY DEFAULT.
# Diagnostic switches, if ever asked for:
#   GTK_REMAP0_ONE=0       # kill-switch: revert to stock decode (flicker returns)
#   GTK_REMAP0_IDENTITY=1  # identity-crossbar A/B variant of the fix
#   GTK_PROBE_11912=1      # dev TIU-transition log
# Leave EMPTY to inject nothing; clearing it removes the profile.d entry on
# the next install.sh run.
RPCS3_ENV_FLAGS=""

# --- Default thermal intent at boot ---
# RACE — full performance; thermal_d switches to PIT on overheat
# PIT  — throttled at boot; restore RACE via the dashboard
DEFAULT_MODE="RACE"

# --- HUD launch-banner hold (seconds) ---
# How long the MODE | GAMEID banner stays on screen before the HUD
# collapses to telemetry-only.
HUD_HEADER_HOLD_S=15

# --- HUD instrument set (read live by bin/mango_bridge.sh) ---
# BASIC  = LOAD + RAM gauges (harvest / early-stage default).
# GINSTR = swap LOAD+RAM for two live frame-pacing gauges off the MangoHud
#          autolog: TURBO (jitter direction — » settling forward, « degrading
#          back) and SLIP (3-stage pacing-slip severity, top rung blinks).
#          The G-INSTR tuning HUD; gauge thresholds are feel-tuned on-rig.
ETK_HUD_MODE="BASIC"

# --- install.sh output mode ---
# 0 = Pit Wall console TUI (recommended; dashboard with progress bars +
#     2-line scrolling datalog, evokes commander.sh aesthetic)
# 1 = raw rsync per-file output (for diagnosing failed installs)
# The --verbose / -v CLI flag forces 1 regardless of this setting.
ETK_VERBOSE=0

# --- DP video-out / capture mirror (bin/dpmirror_d.sh) ---
# Behaviour when a capture display links on USB-C DisplayPort (DP-1). Read live
# by the daemon (no reinstall needed — an edit takes effect within ~3s).
#   1 = MIRROR: game stays native on the handheld AND is mirrored to the capture
#       output via wl-mirror. Both screens. Small GPU/FPS cost while capturing.
#   0 = RECORD-ONLY: game renders directly on the capture output (native, full
#       quality, NO wl-mirror = no FPS cost). Handheld screen sits idle.
# NOTE: DP only links in the Type-C "normal" plug orientation (kernel AUX bug).
ETK_DP_MIRROR=1

# --- Private Paddock (optional — personal cloud backup of YOUR vaults/saves/tunes) ---
# To get private shader storage, add your GitHub token here BEFORE running
# ./install.sh. The PADDOCK tab appears on the rig only when this is configured.
# Preferred token: fine-grained PAT scoped to ONE repo (<you>/etk-paddock),
# contents read/write only. Create the private repo first (fine-grained PATs
# cannot create repos). A classic `repo`-scope PAT also works and lets
# install.sh auto-create the repo for you.
# ETK never shares these bytes: your repo, your token, your shaders.
PADDOCK_TOKEN=""
# Optional override; default is <token-owner>/etk-paddock
PADDOCK_REPO=""
