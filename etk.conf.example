# ============================================================
# ETK OPERATOR CONFIG  (etk.conf — gitignored)
# ============================================================
# This file is auto-generated by ./install.sh on first run.
# Edit values freely; re-run ./install.sh to push changes to the rig.
# Lines starting with # are comments; blank lines are ignored.
# ============================================================

# --- Rig SSH target ---
# Rocknix publishes itself via mDNS as <SOC>.local out of the box:
#   SM8250.local — Retroid Pocket Flip 2, RP5, other SD865 devices
#   SM8550.local — Odin 2 family
# This default works on any LAN where mDNS is functioning, so you
# don't need to edit it when you change WiFi networks. If your
# network blocks mDNS, replace with an IP form (e.g. root@10.0.0.40).
RIG_SSH="root@SM8250.local"

# --- Build tier ---
# FULL — shader vault + thermal protection + HUD telemetry (recommended)
# LITE — thermal protection + HUD only (for saturated shader caches)
# RAW  — HUD only, no protection (for stress testing)
ETK_BUILD_TYPE="FULL"

# --- Custom Turnip driver (Stage IV — optional) ---
# Path to a self-built Mesa Turnip .so (ROCKNIX glibc/msm build) to pin over
# the stock nightly driver. install.sh pushes it to /storage/turnip/ and a
# boot-persistent systemd unit (etk-turnip.service) bind-mounts it every cold
# boot. Leave EMPTY to run the stock Turnip (the unit self-skips). The .so is
# built by scripts/build_rocknix.sh; deploy a one-off (no reinstall) via
# scripts/deploy_rocknix.sh. Re-validate any swap on a COLD boot.
TURNIP_SO=""

# --- Default thermal intent at boot ---
# RACE — full performance; thermal_d switches to PIT on overheat
# PIT  — throttled at boot; restore RACE via the dashboard
DEFAULT_MODE="RACE"

# --- HUD launch-banner hold (seconds) ---
# How long the MODE | GAMEID banner stays on screen before the HUD
# collapses to telemetry-only.
HUD_HEADER_HOLD_S=15

# --- install.sh output mode ---
# 0 = Pit Wall console TUI (recommended; dashboard with progress bars +
#     2-line scrolling datalog, evokes commander.sh aesthetic)
# 1 = raw rsync per-file output (for diagnosing failed installs)
# The --verbose / -v CLI flag forces 1 regardless of this setting.
ETK_VERBOSE=0

# --- Private Paddock (optional — personal cloud backup of YOUR vaults/saves/tunes) ---
# To get private shader storage, add your GitHub token here BEFORE running
# ./install.sh. The PADDOCK tab appears on the rig only when this is configured.
# Preferred token: fine-grained PAT scoped to ONE repo (<you>/etk-paddock),
# contents read/write only. Create the private repo first (fine-grained PATs
# cannot create repos). A classic `repo`-scope PAT also works and lets
# install.sh auto-create the repo for you.
# ETK never shares these bytes: your repo, your token, your shaders.
PADDOCK_TOKEN=""
# Optional override; default is <token-owner>/etk-paddock
PADDOCK_REPO=""
