# ============================================================
# ETK OPERATOR CONFIG  (etk.conf — gitignored)
# ============================================================
# This file is auto-generated by ./install.sh on first run.
# Edit values freely; re-run ./install.sh to push changes to the rig.
# Lines starting with # are comments; blank lines are ignored.
# ============================================================

# --- Rig SSH target ---
# Rocknix publishes itself via mDNS as <SOC>.local out of the box:
#   SM8250.local — Retroid Pocket Flip 2, RP5, other SD865 devices
#   SM8550.local — Odin 2 family
# This default works on any LAN where mDNS is functioning, so you
# don't need to edit it when you change WiFi networks. If your
# network blocks mDNS, replace with an IP form (e.g. root@10.0.0.40).
RIG_SSH="root@SM8250.local"

# --- Build tier ---
# FULL — shader vault + thermal protection + HUD telemetry (recommended)
# LITE — thermal protection + HUD only (for saturated shader caches)
# RAW  — HUD only, no protection (for stress testing)
ETK_BUILD_TYPE="FULL"

# --- Host<->rig shader sync (Tier-A vault) ---
# Controls how install.sh syncs the harvested SHADER vault between this computer
# and the rig. (Your telemetry/tuned configs/saves — Tier-B — are always backed
# up rig->host on every run regardless of this, and only restored host->rig with
# --restore-state.) Override per-run with `./install.sh --sync-mode=MODE`.
#   full   — pull (rig->host harvest) AND push (host->rig restore). The classic
#            two-way mirror; use if the host PC is your shader backup/restore.
#   backup — pull ONLY. Host is a read-only archive; install never pushes shaders
#            back, so a stale host vault can't re-seed the rig after a Mesa bump.
#            RECOMMENDED once you back shaders up to your Private Paddock (PADDOCK
#            tab), which then owns restore.
#   off    — no host shader sync at all. Leanest; rely entirely on Private Paddock.
VAULT_SYNC="full"

# --- Chiaki Remote Play (PS4/PS5 streaming) ---
# 1 — deploy the chiaki client to the rig and register "Chiaki Remote Play"
#     in the ES Tools menu (the GT7 streaming lane). Pair once from this
#     computer (console PIN + PSN account id); pairing secrets live on the
#     rig at /storage/.config/chiaki/ and are never synced or published.
# 0 — skip deploy, Tools entry and tripwire entirely.
ETK_CHIAKI="1"

# --- Custom Turnip driver catalog (Stage IV — optional) ---
# The on-rig CATALOG (/storage/turnip/drivers/) is what Pitstop's DRIVER tab
# (DRIVER BUILD selector) offers. Pick one, reboot to load it — the choice
# persists across reboot and reinstall. 'stock' = ROCKNIX's own Turnip (unbind).
# Re-validate any swap on a COLD boot.
#
# The host drivers/ folder IS the catalog: drop a ROCKNIX glibc/msm .so in and
# install.sh stages it — no allowlist, no sha to register. The on-rig catalog
# MIRRORS drivers/, so deleting a build locally also retires it from the rig
# (the current DRIVER-tab selection is never pruned out from under you).
# Builds come from scripts/build_rocknix.sh or the etk-turnip-gtk fork.
#
# A fresh clone has an empty drivers/ (it's gitignored), so a normal install
# fetches the proven fork from the latest GitHub release — sha256-verified — and
# the catalog is "stock + the proven fork" as before. Local builds simply add to it.
#
# Every session's ledger row records which build actually ran (tune_tag carries a
# build= prefix read from /storage/turnip/loaded), so etk_dyno scores each driver
# as its own arm instead of pooling them.
#
# TURNIP_SO (optional): path to ONE .so that is the DEFAULT pick on a rig that
# hasn't chosen yet (also staged into the catalog if it lives outside drivers/).
# Leave EMPTY to default a fresh rig to stock.
TURNIP_SO=""

# --- Custom kernel (Tier K — optional, advanced) ---
# ETK can build its own ROCKNIX 7.0.11 kernel (mainline tarball + ROCKNIX patch
# stack + rig config; see the RocknixGtkKernel pipeline). Point KERNEL_IMAGE at a
# built Image and install.sh stages it as a SEPARATE boot entry
# (/flash/KERNEL.gtktest, 'ROCKNIX-GTK TEST kernel') — the DEFAULT boot entry
# still loads the stock kernel, so recovery is one reboot-to-default away. Reboot
# on-device and PICK the TEST entry to run it. The grub entry is refreshed on
# every install (survives OS grub-twin reverts). Leave EMPTY = don't touch the
# kernel (the normal case; stock installs are unaffected).
KERNEL_IMAGE=""
# KERNEL_CONTEXT_KEEPALIVE: 1 => bake `msm.context_keepalive=1` into the TEST
# entry's cmdline (KGSL parity — the guilty GPU context survives a hangcheck
# recovery instead of being banned; needs a parity-built kernel). Auto-arms at
# boot; the runtime toggle /sys/module/msm/parameters/context_keepalive still
# works on top for A/B. Harmless (ignored) on a stock kernel. Default 0.
KERNEL_CONTEXT_KEEPALIVE="0"
# KERNEL_DEPLOY_MODE: "test" (default) => the GTK entry is pick-per-boot at the
# grub menu; the saved default stays whatever was last chosen (stock on a virgin
# rig). "default" => AUTO-BOOT the GTK kernel on every reboot (2-second menu
# window). Fallbacks in default mode: the stock device entries stay in the menu
# (picking one re-sticks stock as the default), and a managed
# 'ROCKNIX-GTK fallback -- stock kernel' entry boots the pristine OS kernel
# snapshot (/flash/KERNEL.etk-stock, taken on first kernel deploy) with the
# verbose forensic console. Setting this back to "test" un-seeds the auto-boot.
KERNEL_DEPLOY_MODE="test"

# --- RPCS3 GTK Edition (the default emulator as of 0.6.0) ---
# rpcs3-sa lives on read-only squashfs (/usr/bin), same story as Turnip's
# /usr/lib driver — ETK bind-mounts its build over it on every boot (stock is
# never modified; unbinding always recovers it). No configuration needed:
#   RPCS3_APPIMAGE=""            -> AUTO (default): install.sh fetches the
#                                   certified GTK Edition from the ETK release,
#                                   sha256-verifies it, and deploys it — the
#                                   same zero-config pattern as the GTK driver.
#   RPCS3_APPIMAGE="stock"       -> opt out; run ROCKNIX's stock rpcs3-sa.
#   RPCS3_APPIMAGE="/path/x.AppImage" -> stage a local build (dev override).
# Source delta + build recipe: github.com/mercurious/etk-rpcs3-gtk. Reboot to
# fully validate (a bind-mount can't hot-swap a binary a running RPCS3 holds).
RPCS3_APPIMAGE=""

# --- Per-title CORE swap (multigame lane, ships ON) ---
# Lets Pitstop TUNING > CORE pin a specific title to a specific RPCS3 core
# build — the LLVM 19-vs-22 split made core choice per-title (RR7/Ratchet
# regress on 22 while Sega/Namco titles gain). Behavior-neutral until you pin:
# with no pins every launch runs the certified core above. The catalog is
# whatever *.AppImage sits in the host ./emulators/ dir at install time (A/B
# tooling; nothing extra is downloaded). Takes effect at next game launch —
# no reboot. Each core keeps its own PPU cache: first boot after a swap
# recompiles, so pin, don't flap.
# 1 = on (default) · 0 = kill-switch (certified AppImage binds directly)
ETK_CORE_SWAP="1"

# --- Community patch surface (multigame lane, ships ON) ---
# RPCS3 already ships a community patch framework (the same "Download latest
# patches" file the desktop GUI manages — MLAA disables, deltatime fixes,
# 30fps caps...). install.sh refreshes that file from the official endpoint
# (sha-verified, offline-safe: a failed fetch keeps what you have) and
# Pitstop TUNING > PATCH shows the patches available for the selected title
# as switches. Nothing is enabled until you flip one; toggles apply at the
# next game launch, no reboot. The active set is recorded in the session
# ledger (patches=), because a patch IS a tune.
# 1 = on (default) · 0 = kill-switch (no fetch; PATCH section still shows a
#     previously fetched file if one exists)
ETK_PATCH_FETCH="1"

# RPCS3_ENV_FLAGS (optional): space-separated VAR=value pairs exported into
# the RPCS3 runtime at every game launch via the profile.d vector
# (/storage/.config/profile.d/096-etk-rpcs3-flags). Used for runtime-gated
# switches baked into a custom RPCS3 build. The GTK Edition needs NOTHING
# here for normal play — the #11912 road-flicker FIX is ON BY DEFAULT.
# Diagnostic switches, if ever asked for:
#   GTK_REMAP0_ONE=0       # kill-switch: revert to stock decode (flicker returns)
#   GTK_REMAP0_IDENTITY=1  # identity-crossbar A/B variant of the fix
#   GTK_PROBE_11912=1      # dev TIU-transition log
# Leave EMPTY to inject nothing; clearing it removes the profile.d entry on
# the next install.sh run.
RPCS3_ENV_FLAGS=""

# --- Default thermal intent at boot ---
# RACE — full performance; thermal_d switches to PIT on overheat
# PIT  — throttled at boot; restore RACE via the dashboard
DEFAULT_MODE="RACE"

# --- HUD launch-banner hold (seconds) ---
# How long the MODE | GAMEID banner stays on screen before the HUD
# collapses to telemetry-only.
HUD_HEADER_HOLD_S=15

# --- HUD instrument set (read live by bin/mango_bridge.sh) ---
# GINSTR = the G-INSTR tuning HUD (the default): two live frame-pacing
#          gauges off the MangoHud autolog — JTTR (jitter direction —
#          » settling forward, « degrading back) and SLIP (3-stage
#          pacing-slip severity, top rung blinks). Feel-tuned on-rig.
# BASIC  = the simple set: LOAD + RAM gauges (harvest / early-stage).
ETK_HUD_MODE="GINSTR"

# --- Hostless self-update (Pitstop TOOLS > Check for ETK Updates) ---
# Updates the ETK middleware layer in place from the latest GitHub release —
# no computer needed. Stack components (emulator/driver/kernel) still come
# from install.sh or the card image. Set to 0 to hide the capability.
ETK_SELF_UPDATE="1"

# --- Golden-default config seeding (0.7.1, ships ON) ---
# When a game appears on the rig with no per-game RPCS3 config yet —
# most commonly a disc .iso copied straight into roms/ps3, which never
# passes through the PKG installer — Pitstop seeds
# custom_configs/config_<ID>.yml from the ETK golden GT5P tune at its
# next open, so no title ever plays on RPCS3's untuned defaults.
# Disc/ISO titles additionally get "Strict Rendering Mode: true" (fixes
# the diagonal rendering artifact seen on disc 1.00 builds, e.g. GT5P
# BCUS98158). Existing configs are never touched. Every seed is logged
# as a GOLDEN SEED row in the TELEMETRY config ledger.
# 1 = on (default) · 0 = kill-switch (titles then start on RPCS3 defaults)
ETK_GOLDEN_SEED=1

# --- ISO onboarding (0.7.2, ships ON) ---
# Makes "copy the .iso into roms/ps3" the entire install. At every
# Pitstop open (emulator idle), each .iso there is made a first-class
# EmulationStation game:
#   * [BRACKET-ID] filename tags become (PARENID) — ROCKNIX's per-game
#     settings engine (get_setting) breaks on [ ] in a ROM name, which
#     silently disables the MangoHud overlay and every per-game setting;
#     the serial stays visible to tell regional/format variants apart.
#   * a <name>.m3u launcher is generated — ES only lists .ps3/.psn/.m3u,
#     so a bare .iso never appears in the carousel without one.
#   * the per-game MangoHud overlay key is enabled (cold launch shows
#     the ETK dashboard, same as PKG installs).
#   * the golden config is seeded from the filename serial (see
#     ETK_GOLDEN_SEED above), before the title's first boot.
# Restart ES (or reboot) after dropping ISOs so the carousel rescans.
# 1 = on (default) · 0 = kill-switch (ISOs are left exactly as dropped)
ETK_ISO_ONBOARD=1

# --- Background installs (0.8.4, ships ON) ---
# A PS3 package or firmware install no longer holds the Pitstop hostage. The
# Pitstop queues the job and a worker runs it out of process, so you can keep
# using the app, go back to your games, or close it entirely while RPCS3
# unpacks — the same way EmulationStation scrapes in the background. Progress
# and the result arrive as on-screen notifications, and queued installs run in
# order.
# A GAME ALWAYS WINS: ROCKNIX rebuilds RPCS3's config directories at every game
# launch — the same directories an install writes into — so if you start a race
# mid-install the worker stands the install down, keeps your place in the
# queue, and resumes when you have finished playing.
# 1 = on (default) · 0 = kill-switch (installs run modally, as in 0.8.3:
#     the Pitstop blocks until the install finishes)
ETK_BG_INSTALL=1

# --- OS-update coherence guard (0.8.3, ships ON) ---
# Makes ROCKNIX in-place updates survivable on a GTK-kernel rig. The ROCKNIX
# updater writes the new kernel over the boot slot the running system used
# and regenerates the boot menu — on a kit rig that used to mean the next
# boot came up with no WiFi and no sound (old kernel, new OS, no drivers).
# The guard runs once per boot: it detects the mismatch, puts the right
# kernel back in the boot slot, restores the GTK entries, and asks you (on
# screen) to reboot once. It NEVER reboots the device itself.
# 1 = on (default) · 0 = kill-switch (guard does nothing)
ETK_OS_GUARD=1

# --- Controller binding repair (0.8.1, ships ON) ---
# Makes the gamepad work in RPCS3 without you touching a pad-config screen.
# ROCKNIX ships RPCS3 a stock pad config pointing at a controller called
# "InputPlumber GameController 1" — the Xbox-style virtual pad InputPlumber
# used to present. It now presents a DualSense instead, so that name matches
# nothing on a Flip 2, and RPCS3 quietly falls back to its "no controller"
# handler: buttons do nothing in game, with no error anywhere on screen.
# At firmware install and at every Pitstop open (emulator idle), ETK asks
# the rig's own SDL what your pad is actually called and corrects ONLY the
# device line. Your button map, dead zones and trigger calibration are never
# touched, and a config that is already right is left byte-for-byte alone.
# 1 = on (default) · 0 = kill-switch (you manage RPCS3's pad config yourself)
ETK_PAD_BIND=1

# --- install.sh output mode ---
# 0 = Pit Wall console TUI (recommended; dashboard with progress bars +
#     2-line scrolling datalog, evokes commander.sh aesthetic)
# 1 = raw rsync per-file output (for diagnosing failed installs)
# The --verbose / -v CLI flag forces 1 regardless of this setting.
ETK_VERBOSE=0

# --- DP video-out / capture mirror (bin/dpmirror_d.sh) ---
# Behaviour when a capture display links on USB-C DisplayPort (DP-1). Read live
# by the daemon (no reinstall needed — an edit takes effect within ~3s).
#   1 = MIRROR: game stays native on the handheld AND is mirrored to the capture
#       output via wl-mirror. Both screens. Small GPU/FPS cost while capturing.
#   0 = RECORD-ONLY: game renders directly on the capture output (native, full
#       quality, NO wl-mirror = no FPS cost). Handheld screen sits idle.
# NOTE: DP only links in the Type-C "normal" plug orientation (kernel AUX bug).
ETK_DP_MIRROR=1

# --- DP capture audio (mirror mode; read live by dpmirror_d) ---
# EXPERIMENTAL — LEAVE OFF. The direct audio-tap approach breaks game launch
# on this kernel (the ADSP cannot feed speaker and DP from one stream); a
# proper DP-sink design is in progress. 0 = off (default) · 1 = experiments only
ETK_DP_AUDIO=0

# --- Gamepad self-heal on display unplug (read live by dpmirror_d) ---
# Unplugging the capture cable can kill the controller system-wide (an OS
# input-service fault; previously only a reboot recovered it). The kit now
# detects the fault signature after an unplug and restarts the affected
# services itself — you'll see a "PAD RECOVERED" notice. If a game is running
# it heals what it safely can and tells you if a relaunch is needed.
#   1 = heal when the fault is detected (default)
#   force = heal on every unplug
#   0 = off (manual recovery: restart inputplumber, then essway)
ETK_DP_PADHEAL=1

# --- Private Paddock (optional — personal cloud backup of YOUR vaults/saves/tunes) ---
# To get private shader storage, add your GitHub token here BEFORE running
# ./install.sh. The PADDOCK tab appears on the rig only when this is configured.
# Preferred token: fine-grained PAT scoped to ONE repo (<you>/etk-paddock),
# contents read/write only. Create the private repo first (fine-grained PATs
# cannot create repos). A classic `repo`-scope PAT also works and lets
# install.sh auto-create the repo for you.
# ETK never shares these bytes: your repo, your token, your shaders.
PADDOCK_TOKEN=""
# Optional override; default is <token-owner>/etk-paddock
PADDOCK_REPO=""

# --- ETK FORGE (./forge.sh — mint the kit's binaries on etk-cloud) ---
# The Engineer's counterpart to install.sh: builds every release artifact on
# the etk-cloud node (or colima with --local), gates it, and STAGES it into
# this tree for testing — it never touches the rig and never publishes.
# All knobs optional; defaults reproduce the current staged artifact names.
# Uncomment to override per release cycle:
#   FORGE_HOST="etk-cloud"            # ~/.ssh/config alias (IP is EPHEMERAL —
#                                     # re-read from the Oracle console on stop/start)
#   FORGE_RPCS3_BASE="a1deb2921"      # upstream base commit the patch applies to
#   FORGE_RPCS3_PATCH=""              # empty = newest patches/*-dev.patch in the fork
#   FORGE_RPCS3_ARTIFACT="rpcs3-etk_gtk-edition-0.8.5_v0.0.41-19638-a1deb2921_linux_aarch64.AppImage"
#   FORGE_TURNIP_VERS="26.1.6 26.2.0-rc3"   # one driver build per version listed
#   FORGE_TURNIP_GTKVER="0.7"         # fork generation in the staged filename
#   FORGE_KERNEL_DATE="20260801"      # 8-digit date segment of the kernel name
#   FORGE_KERNEL_VER="0.3.1"          # digits-and-dots only (law #8, gated)
#   FORGE_IMAGE_BASEDATE="20260801"   # base ROCKNIX release the image builds on

# --- Bog Profiler (R1+DPAD-Down mid-race; bin/bog_profile.sh) ---
# Seconds sampled per chord press. 30 = the default deep sample; 15 fits a
# single track SECTION for lap-mapping stints (e.g. Eiger lock-vs-slush:
# chord in the slush AND in the locked stretches — each sample self-labels
# via its fps_end meta + the perf timeline join). Newest 12 sets kept on-rig.
BOG_PROFILE_SECS="30"
