{
  "_comment": "ETK POWER profiles (SM8250). Runtime sysfs power knobs ONLY. Pulldown options are real OPP steps; the Pitstop POWER tab resolves a preset/knobs into a flat path<TAB>value profile that etk-power.service re-applies at boot. GPU: Qualcomm's spec for the Adreno 650 is 587 MHz (670 on the 870 bin); the ROCKNIX device tree adds overclock OPPs (to 800 MHz through the 20260901 era, to 925 MHz on 20261001), and the `performance` governor rides to whatever the table's top is -- gpu_ceiling caps it (2026-10-11, GT5 op: every GT5 death the flight recorder caught ran at 925 MHz). Per-SoC: a new chipset ships its own JSON.",
  "soc": "SM8250",
  "knobs": [
    {
      "id": "gpu_ceiling",
      "label": "GPU clock ceiling",
      "paths": [
        "/sys/class/devfreq/3d00000.gpu/max_freq"
      ],
      "note": "Qualcomm spec 587; above it = overclock",
      "options": [
        {
          "v": "925000000",
          "l": "925 MHz (OPP top, no cap)"
        },
        {
          "v": "800000000",
          "l": "800 MHz"
        },
        {
          "v": "670000000",
          "l": "670 MHz (870 bin spec)"
        },
        {
          "v": "587000000",
          "l": "587 MHz (Qualcomm spec)"
        }
      ]
    },
    {
      "id": "gpu_gov",
      "label": "GPU governor",
      "paths": [
        "/sys/class/devfreq/3d00000.gpu/governor"
      ],
      "options": [
        {
          "v": "simple_ondemand",
          "l": "simple_ondemand"
        },
        {
          "v": "performance",
          "l": "performance"
        },
        {
          "v": "powersave",
          "l": "powersave"
        }
      ]
    },
    {
      "id": "gpu_floor",
      "label": "GPU clock floor",
      "paths": [
        "/sys/class/devfreq/3d00000.gpu/min_freq"
      ],
      "note": "a floor above the ceiling clamps to the ceiling",
      "options": [
        {
          "v": "305000000",
          "l": "305 MHz (auto)"
        },
        {
          "v": "650000000",
          "l": "650 MHz"
        },
        {
          "v": "800000000",
          "l": "800 MHz (pin)"
        }
      ]
    },
    {
      "id": "cpu_gov",
      "label": "CPU governor",
      "paths": [
        "/sys/devices/system/cpu/cpufreq/policy0/scaling_governor",
        "/sys/devices/system/cpu/cpufreq/policy4/scaling_governor",
        "/sys/devices/system/cpu/cpufreq/policy7/scaling_governor"
      ],
      "options": [
        {
          "v": "ondemand",
          "l": "ondemand"
        },
        {
          "v": "performance",
          "l": "performance"
        },
        {
          "v": "schedutil",
          "l": "schedutil"
        },
        {
          "v": "powersave",
          "l": "powersave"
        }
      ]
    },
    {
      "id": "cpu_prime_floor",
      "label": "CPU prime floor",
      "paths": [
        "/sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq"
      ],
      "note": "rsx::thread lever",
      "options": [
        {
          "v": "844800",
          "l": "0.84 GHz (auto)"
        },
        {
          "v": "1632000",
          "l": "1.63 GHz"
        },
        {
          "v": "2841600",
          "l": "2.84 GHz (pin)"
        }
      ]
    },
    {
      "id": "cpu_gold_floor",
      "label": "CPU gold floor",
      "paths": [
        "/sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq"
      ],
      "options": [
        {
          "v": "710400",
          "l": "0.71 GHz (auto)"
        },
        {
          "v": "2419200",
          "l": "2.42 GHz (pin)"
        }
      ]
    },
    {
      "id": "cpu_deep_idle",
      "label": "CPU deep idle",
      "tag": "idleoff",
      "paths": [
        "/sys/devices/system/cpu/cpu0/cpuidle/state1/disable",
        "/sys/devices/system/cpu/cpu1/cpuidle/state1/disable",
        "/sys/devices/system/cpu/cpu2/cpuidle/state1/disable",
        "/sys/devices/system/cpu/cpu3/cpuidle/state1/disable",
        "/sys/devices/system/cpu/cpu4/cpuidle/state1/disable",
        "/sys/devices/system/cpu/cpu5/cpuidle/state1/disable",
        "/sys/devices/system/cpu/cpu6/cpuidle/state1/disable",
        "/sys/devices/system/cpu/cpu7/cpuidle/state1/disable"
      ],
      "note": "psci power collapse; off = WFI only (GT5 hunt arm A)",
      "options": [
        {
          "v": "0",
          "l": "on (stock)"
        },
        {
          "v": "1",
          "l": "off (WFI only)"
        }
      ]
    },
    {
      "id": "ufs_clock",
      "label": "UFS clock scaling",
      "tag": "ufspin",
      "paths": [
        "/sys/class/devfreq/1d84000.ufshc/governor"
      ],
      "note": "pinned = performance, no 37.5<->300 MHz switches (GT5 hunt arm B)",
      "options": [
        {
          "v": "simple_ondemand",
          "l": "scaling (stock)"
        },
        {
          "v": "performance",
          "l": "pinned 300 MHz"
        }
      ]
    },
    {
      "id": "grid",
      "label": "GRID affinity",
      "paths": [],
      "note": "big.LITTLE thread pinning via bin/grid_apply.sh (no sysfs path -- applied to the live emulator at POWER apply + re-asserted by thermal_d). Experiment: dossiers/GridModeAffinity_Spec_20260710.md. Presets deliberately omit this knob so preset identity (pwr= tag) is unaffected; the tag gains a +g<rung> suffix instead.",
      "options": [
        {
          "v": "off",
          "l": "off (scheduler decides)"
        },
        {
          "v": "A",
          "l": "A -- quarantine noise to silvers"
        },
        {
          "v": "B",
          "l": "B -- rsx=prime, PPU+SPU=golds, noise=silvers"
        },
        {
          "v": "C",
          "l": "C -- B + SPU may use silvers too"
        }
      ]
    }
  ],
  "presets": [
    {
      "id": "BALANCED",
      "label": "BALANCED",
      "desc": "stock ondemand \u2014 the validated baseline",
      "values": {
        "gpu_gov": "simple_ondemand",
        "gpu_floor": "305000000",
        "cpu_gov": "ondemand",
        "cpu_prime_floor": "844800",
        "cpu_gold_floor": "710400"
      }
    },
    {
      "id": "RACE",
      "label": "RACE",
      "desc": "GPU pinned to the ceiling (default: the OPP top) \u00b7 max heat \u00b7 thermal-guarded",
      "values": {
        "gpu_gov": "performance",
        "gpu_floor": "800000000",
        "cpu_gov": "performance",
        "cpu_prime_floor": "2841600",
        "cpu_gold_floor": "2419200"
      }
    },
    {
      "id": "COOL",
      "label": "COOL",
      "desc": "capped for thermal / battery",
      "values": {
        "gpu_gov": "simple_ondemand",
        "gpu_floor": "305000000",
        "cpu_gov": "powersave",
        "cpu_prime_floor": "844800",
        "cpu_gold_floor": "710400"
      }
    }
  ]
}
